ADYEN_API_KEY=YOUR_ADYEN_API_KEY
ADYEN_MERCHANT_ACCOUNT=YOUR_MERCHANT_ACCOUNT
VITE_ADYEN_CLIENT_KEY=YOUR_ADYEN_CLIENT_KEY

# PayPal Sandbox Credentials
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_SANDBOX_SECRET
PUBLIC_PAYPAL_CLIENT_ID=YOUR_PAYPAL_SANDBOX_CLIENT_ID

# PayPal Production Credentials
PAYPAL_PROD_CLIENT_SECRET=YOUR_PAYPAL_PRODUCTION_SECRET
PUBLIC_PAYPAL_PROD_CLIENT_ID=YOUR_PAYPAL_PRODUCTION_CLIENT_ID

# Braintree Sandbox Gateway
BRAINTREE_MERCHANT_ID=YOUR_BRAINTREE_SANDBOX_MERCHANT_ID
BRAINTREE_PUBLIC_KEY=YOUR_BRAINTREE_SANDBOX_PUBLIC_KEY
BRAINTREE_PRIVATE_KEY=YOUR_BRAINTREE_SANDBOX_PRIVATE_KEY
# Merchant account whose linked PayPal account owns the billing agreements.
# Leave unset to use the gateway default.
BRAINTREE_MERCHANT_ACCOUNT_ID=

# Braintree Production Gateway
BRAINTREE_PROD_PUBLIC_KEY=YOUR_BRAINTREE_PRODUCTION_PUBLIC_KEY
BRAINTREE_PROD_PRIVATE_KEY=YOUR_BRAINTREE_PRODUCTION_PRIVATE_KEY
BRAINTREE_PROD_MERCHANT_ACCOUNT_ID=
